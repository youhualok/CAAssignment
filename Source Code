LOG_TRANSACTION PROC
    MOV logTempType,AL
    MOV logTempBook,BL
    MOV logTempAmount,DX
    PUSH AX
    PUSH BX
    PUSH CX
    PUSH SI
    CMP historyCount,20
    JAE LOG_SHIFT_HISTORY
    XOR AX,AX
    MOV AL,historyCount
    MOV SI,AX
    JMP LOG_STORE
LOG_SHIFT_HISTORY:
    XOR SI,SI
    MOV CX,19
LOG_SHIFT_LOOP:
    MOV AH,historyType[SI+1]
    MOV historyType[SI],AH
    MOV AH,historyBook[SI+1]
    MOV historyBook[SI],AH
    MOV BX,SI
    SHL BX,1
    MOV AX,historyAmount[BX+2]
    MOV historyAmount[BX],AX
    INC SI
    LOOP LOG_SHIFT_LOOP
    MOV SI,19
    JMP LOG_STORE
LOG_STORE:
    MOV AL,logTempType
    MOV historyType[SI],AL
    MOV AL,logTempBook
    MOV historyBook[SI],AL
    MOV BX,SI
    SHL BX,1
    MOV AX,logTempAmount
    MOV historyAmount[BX],AX
    CMP historyCount,20
    JAE LOG_DONE
    INC historyCount
LOG_DONE:
    POP SI
    POP CX
    POP BX
    POP AX
    RET
LOG_TRANSACTION ENDP

