LOAN_DUE_DATE_CALCULATOR PROC
    CALL CLEAR_SCREEN
    LEA DX,dateTitle
    CALL PRINT_STRING
    CMP activeLoan,1
    JE DUE_DATE_HAS_LOAN
    LEA DX,dateNoLoanMsg
    CALL PRINT_STRING
    CALL PAUSE_SCREEN
    RET
DUE_DATE_HAS_LOAN:
    CALL READ_VALID_DATE
    MOV AX,currentDay
    MOV dueDay,AX
    MOV AX,currentMonth
    MOV dueMonth,AX
    MOV AX,currentYear
    MOV dueYear,AX
    MOV CX,loanDays
    CMP CX,0
    JE DUE_DATE_READY
DUE_DATE_ADD_LOOP:
    INC dueDay
    MOV AX,dueMonth
    MOV BX,dueYear
    CALL GET_DAYS_IN_MONTH
    MOV AX,dueDay
    CMP AX,daysInMonth
    JBE DUE_DATE_NEXT_DAY
    MOV dueDay,1
    INC dueMonth
    CMP dueMonth,12
    JBE DUE_DATE_NEXT_DAY
    MOV dueMonth,1
    INC dueYear
DUE_DATE_NEXT_DAY:
    LOOP DUE_DATE_ADD_LOOP
DUE_DATE_READY:
    LEA DX,borrowDateMsg
    CALL PRINT_STRING
    MOV AX,currentDay
    CALL PRINT_TWO_DIGIT
    LEA DX,dateSeparator
    CALL PRINT_STRING
    MOV AX,currentMonth
    CALL PRINT_TWO_DIGIT
    LEA DX,dateSeparator
    CALL PRINT_STRING
    MOV AX,currentYear
    CALL PRINT_NUM
    LEA DX,dueDateMsg
    CALL PRINT_STRING
    MOV AX,dueDay
    CALL PRINT_TWO_DIGIT
    LEA DX,dateSeparator
    CALL PRINT_STRING
    MOV AX,dueMonth
    CALL PRINT_TWO_DIGIT
    LEA DX,dateSeparator
    CALL PRINT_STRING
    MOV AX,dueYear
    CALL PRINT_NUM
    CALL PAUSE_SCREEN
    RET
LOAN_DUE_DATE_CALCULATOR ENDP

READ_VALID_DATE PROC
READ_DATE_RETRY:
    LEA DX,dayPrompt
    MOV CX,1
    MOV BX,31
    CALL READ_NUMBER_RANGE
    MOV currentDay,AX
    LEA DX,monthPrompt
    MOV CX,1
    MOV BX,12
    CALL READ_NUMBER_RANGE
    MOV currentMonth,AX
    LEA DX,yearPrompt
    MOV CX,2024
    MOV BX,2099
    CALL READ_NUMBER_RANGE
    MOV currentYear,AX
    MOV AX,currentMonth
    MOV BX,currentYear
    CALL GET_DAYS_IN_MONTH
    MOV AX,currentDay
    CMP AX,daysInMonth
    JBE READ_DATE_VALID
    LEA DX,dateInvalidMsg
    CALL PRINT_STRING
    JMP READ_DATE_RETRY
READ_DATE_VALID:
    RET
READ_VALID_DATE ENDP

GET_DAYS_IN_MONTH PROC
    CMP AX,1
    JE MONTH_HAS_31
    CMP AX,2
    JE MONTH_IS_FEBRUARY
    CMP AX,3
    JE MONTH_HAS_31
    CMP AX,4
    JE MONTH_HAS_30
    CMP AX,5
    JE MONTH_HAS_31
    CMP AX,6
    JE MONTH_HAS_30
    CMP AX,7
    JE MONTH_HAS_31
    CMP AX,8
    JE MONTH_HAS_31
    CMP AX,9
    JE MONTH_HAS_30
    CMP AX,10
    JE MONTH_HAS_31
    CMP AX,11
    JE MONTH_HAS_30
    JMP MONTH_HAS_31
MONTH_HAS_30:
    MOV daysInMonth,30
    RET
MONTH_HAS_31:
    MOV daysInMonth,31
    RET
MONTH_IS_FEBRUARY:
    PUSH AX
    PUSH BX
    PUSH CX
    PUSH DX
    MOV CX,BX
    MOV AX,CX
    XOR DX,DX
    MOV BX,400
    DIV BX
    CMP DX,0
    JE FEBRUARY_LEAP
    MOV AX,CX
    XOR DX,DX
    MOV BX,100
    DIV BX
    CMP DX,0
    JE FEBRUARY_NORMAL
    MOV AX,CX
    XOR DX,DX
    MOV BX,4
    DIV BX
    CMP DX,0
    JE FEBRUARY_LEAP
FEBRUARY_NORMAL:
    MOV daysInMonth,28
    JMP FEBRUARY_DONE
FEBRUARY_LEAP:
    MOV daysInMonth,29
FEBRUARY_DONE:
    POP DX
    POP CX
    POP BX
    POP AX
    RET
GET_DAYS_IN_MONTH ENDP

