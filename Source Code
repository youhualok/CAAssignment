READ_NUMBER_RANGE PROC
    ; Input: DX = prompt address, CX = minimum, BX = maximum
    ; Output: AX = validated number
    MOV tempMin,CX
    MOV tempMax,BX
    PUSH DX
NUMBER_RETRY:
    POP DX
    PUSH DX
    CALL PRINT_STRING
    CALL READ_LINE
    CALL PARSE_NUMBER
    JC NUMBER_FORMAT_ERROR
    CMP AX,tempMin
    JB NUMBER_RANGE_ERROR
    CMP AX,tempMax
    JA NUMBER_RANGE_ERROR
    POP DX
    RET
NUMBER_FORMAT_ERROR:
    LEA DX,invalidNumber
