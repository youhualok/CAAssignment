; ================================================================
; FUNCTION 2 - BORROW BOOK AND REDUCE AVAILABLE COPY COUNT
; ================================================================
BORROW_BOOK PROC
    CMP activeLoan,1
    JNE BORROW_ALLOWED
    LEA DX,alreadyLoanMsg
    CALL PRINT_STRING
    CALL PAUSE_SCREEN
    RET

BORROW_ALLOWED:
    CALL DISPLAY_CATALOGUE
    LEA DX,chooseBookMsg
    MOV CX,1
    MOV BX,10
    CALL READ_NUMBER_RANGE
    MOV SI,AX
    DEC SI
    CMP bookAvailable[SI],0
    JNE BOOK_IN_STOCK
    LEA DX,notAvailableMsg
    CALL PRINT_STRING
    CALL PAUSE_SCREEN
    RET

BOOK_IN_STOCK:
    PUSH SI
    LEA DX,daysPrompt
    MOV CX,1
    MOV BX,14
    CALL READ_NUMBER_RANGE
    MOV loanDays,AX
    LEA DX,borrowConfirm
    CALL READ_YN
    POP SI
    CMP AL,1
    JNE BORROW_CANCELLED

    DEC bookAvailable[SI]
    INC SI
    MOV AX,SI
    MOV currentBook,AL
    MOV activeLoan,1
    MOV renewCount,0
    INC borrowCount
    MOV AL,1
    MOV BL,currentBook
    XOR DX,DX
    CALL LOG_TRANSACTION
    LEA DX,borrowOK
    CALL PRINT_STRING
