; ================================================================
; FUNCTIONS 3-5 - GROSS FINE, DISCOUNT, AND NET FINE CALCULATIONS
; Gross fine = overdue days x RM2
; Discount = gross fine x 20 / 100 when gross fine >= RM20
; Net fine = gross fine - discount
; ================================================================
CALCULATE_FINE PROC
    ; Input: AX = overdue days. Output variables are updated.
    MOV tempOverdue,AX
    MOV BX,2
    MUL BX
    MOV tempGross,AX
    MOV tempDiscount,0
    CMP AX,20
    JB NO_FINE_DISCOUNT
    MOV BX,20
    MUL BX
    MOV BX,100
    XOR DX,DX
    DIV BX
    MOV tempDiscount,AX
NO_FINE_DISCOUNT:
    MOV AX,tempGross
    SUB AX,tempDiscount
    MOV tempNet,AX
    RET
CALCULATE_FINE ENDP

