VALIDATE_CARD_NUMBER PROC
    PUSH CX
    PUSH SI
    CMP inputBuffer[1],16
    JNE CARD_NUMBER_INVALID
    LEA SI,inputBuffer+2
    MOV CX,16
CARD_NUMBER_DIGIT_LOOP:
    MOV AL,[SI]
    CMP AL,'0'
    JB CARD_NUMBER_INVALID
    CMP AL,'9'
    JA CARD_NUMBER_INVALID
    INC SI
    LOOP CARD_NUMBER_DIGIT_LOOP
    MOV AL,1
    JMP CARD_NUMBER_VALIDATION_DONE
CARD_NUMBER_INVALID:
    MOV AL,0
CARD_NUMBER_VALIDATION_DONE:
    POP SI
    POP CX
    RET
VALIDATE_CARD_NUMBER ENDP

