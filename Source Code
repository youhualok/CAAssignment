READ_PASSWORD PROC
    PUSH AX
    PUSH BX
    PUSH DX
    XOR BX,BX
PASSWORD_KEY:
    MOV AH,08H
    INT 21H
    CMP AL,13
    JE PASSWORD_DONE
    CMP AL,8
    JE PASSWORD_BACKSPACE
    CMP BX,10
    JAE PASSWORD_KEY
    MOV passwordBuffer[BX+2],AL
    INC BX
    MOV DL,'*'
    MOV AH,02H
    INT 21H
    JMP PASSWORD_KEY
PASSWORD_BACKSPACE:
    CMP BX,0
    JE PASSWORD_KEY
    DEC BX
    MOV DL,8
    MOV AH,02H
    INT 21H
    MOV DL,' '
    INT 21H
    MOV DL,8
    INT 21H
    JMP PASSWORD_KEY
PASSWORD_DONE:
    MOV passwordBuffer[1],BL
    LEA DX,crlf
    CALL PRINT_STRING
    POP DX
    POP BX
    POP AX
    RET
READ_PASSWORD ENDP

