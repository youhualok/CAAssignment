PARSE_NUMBER PROC
    ; Converts inputBuffer to an unsigned integer (0-9999).
    ; CF=0 success with AX=value; CF=1 invalid.
    CMP inputBuffer[1],0
    JE PARSE_BAD
    CMP inputBuffer[1],4
    JA PARSE_BAD
    LEA SI,inputBuffer+2
    XOR CH,CH
    MOV CL,inputBuffer[1]
    XOR BX,BX
PARSE_LOOP:
    MOV AL,[SI]
    CMP AL,'0'
    JB PARSE_BAD
    CMP AL,'9'
    JA PARSE_BAD
    SUB AL,'0'
    XOR AH,AH
    PUSH AX
    MOV AX,BX
    MOV DX,10
    MUL DX
    MOV BX,AX
    POP AX
    ADD BX,AX
    INC SI
    LOOP PARSE_LOOP
    MOV AX,BX
    CLC
    RET
PARSE_BAD:
    STC
    RET
PARSE_NUMBER ENDP

READ_YN PROC
