.CODE

MAIN PROC
    MOV AX,@DATA
    MOV DS,AX

LOGIN_SCREEN:
    CALL CLEAR_SCREEN
    LEA DX,line
    CALL PRINT_STRING
    LEA DX,titleMsg
    CALL PRINT_STRING
    LEA DX,line
    CALL PRINT_STRING
    LEA DX,loginTitle
    CALL PRINT_STRING
    LEA DX,attemptMsg
    CALL PRINT_STRING

    LEA DX,userPrompt
    CALL PRINT_STRING
    CALL READ_LINE
    CALL CHECK_USERNAME
    CMP AL,1
    JE USERNAME_ACCEPTED
    JMP BAD_LOGIN
USERNAME_ACCEPTED:

    LEA DX,passPrompt
    CALL PRINT_STRING
    CALL READ_PASSWORD
    CALL CHECK_PASSWORD
    CMP AL,1
    JE PASSWORD_ACCEPTED
    JMP BAD_LOGIN
PASSWORD_ACCEPTED:

    MOV loginAttempts,0
    LEA DX,loginOK
    CALL PRINT_STRING
    CALL PAUSE_SCREEN
    CALL RESET_MEMBER_SESSION
    CALL REGISTER_MEMBER

MAIN_MENU_LOOP:
    CALL CLEAR_SCREEN
    LEA DX,titleMsg
    CALL PRINT_STRING
    LEA DX,mainMenu
    MOV CX,1
    MOV BX,8
    CALL READ_NUMBER_RANGE

    CMP AX,1
    JE OPEN_BOOK_MENU
    CMP AX,2
    JE OPEN_FINE_CALCULATOR
    CMP AX,3
    JE OPEN_REPORT
    CMP AX,4
    JE DO_LOGOUT
    CMP AX,5
    JE DO_EXIT
    CMP AX,6
    JE OPEN_SEARCH
    CMP AX,7
    JE OPEN_HELP
    JMP OPEN_ACCOUNT

OPEN_BOOK_MENU:
    CALL BOOK_OPERATIONS
    JMP MAIN_MENU_LOOP

OPEN_FINE_CALCULATOR:
    CALL FINE_CALCULATOR
    JMP MAIN_MENU_LOOP

OPEN_REPORT:
    CALL DISPLAY_REPORT
    JMP MAIN_MENU_LOOP

OPEN_SEARCH:
    CALL SEARCH_CATALOGUE
    JMP MAIN_MENU_LOOP

OPEN_HELP:
    CALL DISPLAY_HELP
    JMP MAIN_MENU_LOOP

OPEN_ACCOUNT:
    CALL ACCOUNT_SERVICES
    JMP MAIN_MENU_LOOP

DO_LOGOUT:
    LEA DX,logoutConfirm
    CALL READ_YN
    CMP AL,1
    JNE MAIN_MENU_LOOP
    LEA DX,logoutOK
    CALL PRINT_STRING
    CALL PAUSE_SCREEN
    JMP LOGIN_SCREEN

DO_EXIT:
    LEA DX,exitConfirm
    CALL READ_YN
    CMP AL,1
    JNE MAIN_MENU_LOOP
    LEA DX,goodbyeMsg
    CALL PRINT_STRING
    MOV AX,4C00H
    INT 21H

BAD_LOGIN:
    INC loginAttempts
    LEA DX,loginFail
    CALL PRINT_STRING
    CMP loginAttempts,3
    JAE LOGIN_LOCKED
    CALL PAUSE_SCREEN
    JMP LOGIN_SCREEN

LOGIN_LOCKED:
    LEA DX,lockedMsg
    CALL PRINT_STRING
    MOV AX,4C01H
    INT 21H
MAIN ENDP

; ================================================================
; BORROWER DATA ENTRY WITH VALIDATION
; ================================================================
REGISTER_MEMBER PROC
    CALL CLEAR_SCREEN
    LEA DX,profileTitle
    CALL PRINT_STRING

GET_MEMBER_NAME:
    LEA DX,namePrompt
    CALL PRINT_STRING
    CALL READ_LINE
    MOV AL,inputBuffer[1]
    CMP AL,0
    JE BAD_NAME
    CMP AL,20
    JA BAD_NAME
    CALL VALIDATE_PERSON_NAME
    CMP AL,1
    JNE BAD_NAME
    LEA SI,inputBuffer+2
    LEA DI,memberName
    XOR CH,CH
    MOV CL,inputBuffer[1]
    CALL COPY_TO_DOLLAR_STRING
    JMP GET_MEMBER_ID

BAD_NAME:
    LEA DX,nameError
    CALL PRINT_STRING
    JMP GET_MEMBER_NAME

GET_MEMBER_ID:
    LEA DX,idPrompt
    CALL PRINT_STRING
    CALL READ_LINE
    CMP inputBuffer[1],4
    JNE BAD_MEMBER_ID
    MOV AL,inputBuffer[2]
    CMP AL,'l'
    JNE CHECK_CAPITAL_L
    MOV inputBuffer[2],'L'
    JMP CHECK_ID_DIGITS
CHECK_CAPITAL_L:
    CMP AL,'L'
    JNE BAD_MEMBER_ID
CHECK_ID_DIGITS:
    MOV SI,3
    MOV CX,3
ID_DIGIT_LOOP:
    MOV AL,inputBuffer[SI]
    CMP AL,'0'
    JB BAD_MEMBER_ID
    CMP AL,'9'
    JA BAD_MEMBER_ID
    INC SI
    LOOP ID_DIGIT_LOOP
    LEA SI,inputBuffer+2
    LEA DI,memberID
    MOV CX,4
    CALL COPY_TO_DOLLAR_STRING
    LEA DX,profileOK
    CALL PRINT_STRING
    CALL PAUSE_SCREEN
    RET

BAD_MEMBER_ID:
    LEA DX,idError
    CALL PRINT_STRING
    JMP GET_MEMBER_ID
REGISTER_MEMBER ENDP

