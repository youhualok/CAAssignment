; ================================================================
; CONTAINS_TEXT
; SI = address of zero-terminated title
; DI = address of uppercase zero-terminated keyword
; AL = 1 when the keyword occurs, otherwise AL = 0
; ================================================================
CONTAINS_TEXT PROC
    PUSH BX
    PUSH CX
    PUSH DX
    PUSH SI
    PUSH DI
    MOV BX,SI

CONTAINS_NEXT_START:
    MOV AL,[BX]
    CMP AL,0
    JE CONTAINS_NOT_FOUND
    MOV SI,BX
    PUSH DI

CONTAINS_COMPARE:
    MOV DL,[DI]
    CMP DL,0
    JE CONTAINS_FOUND_POP
    MOV AL,[SI]
    CMP AL,0
    JE CONTAINS_MISMATCH
    CALL TO_UPPER_AL
    CMP AL,DL
    JNE CONTAINS_MISMATCH
    INC SI
    INC DI
    JMP CONTAINS_COMPARE

CONTAINS_MISMATCH:
    POP DI
    INC BX
    JMP CONTAINS_NEXT_START

CONTAINS_FOUND_POP:
    POP DI
    MOV AL,1
    JMP CONTAINS_EXIT

CONTAINS_NOT_FOUND:
    MOV AL,0

CONTAINS_EXIT:
    POP DI
    POP SI
    POP DX
    POP CX
    POP BX
    RET
CONTAINS_TEXT ENDP

; ================================================================
; TO_UPPER_AL - converts ASCII a-z to A-Z, preserves other bytes.
; ================================================================
TO_UPPER_AL PROC
    CMP AL,'a'
    JB UPPER_DONE
    CMP AL,'z'
    JA UPPER_DONE
    SUB AL,20H
UPPER_DONE:
    RET
TO_UPPER_AL ENDP

