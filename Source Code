VALIDATE_PERSON_NAME PROC
    PUSH BX
    PUSH CX
    PUSH SI
    LEA SI,inputBuffer+2
    XOR CH,CH
    MOV CL,inputBuffer[1]
    XOR BX,BX
VALIDATE_NAME_LOOP:
    MOV AL,[SI]
    CMP AL,' '
    JE VALIDATE_NAME_SPACE
    CMP AL,'A'
    JB VALIDATE_NAME_BAD
    CMP AL,'Z'
    JBE VALIDATE_NAME_LETTER
    CMP AL,'a'
    JB VALIDATE_NAME_BAD
    CMP AL,'z'
    JA VALIDATE_NAME_BAD
VALIDATE_NAME_LETTER:
    MOV BX,1
    JMP VALIDATE_NAME_NEXT
VALIDATE_NAME_SPACE:
    CMP BX,0
    JE VALIDATE_NAME_BAD
VALIDATE_NAME_NEXT:
    INC SI
    LOOP VALIDATE_NAME_LOOP
    CMP BX,1
    JNE VALIDATE_NAME_BAD
    MOV AL,1
    JMP VALIDATE_NAME_EXIT
VALIDATE_NAME_BAD:
    MOV AL,0
VALIDATE_NAME_EXIT:
    POP SI
    POP CX
    POP BX
    RET
VALIDATE_PERSON_NAME ENDP

VALIDATE_MEMBER_ID_BUFFER PROC
    CMP inputBuffer[1],4
    JNE VALIDATE_ID_BAD
    MOV AL,inputBuffer[2]
    CMP AL,'l'
    JNE VALIDATE_ID_CAPITAL
    MOV inputBuffer[2],'L'
    JMP VALIDATE_ID_DIGITS
VALIDATE_ID_CAPITAL:
    CMP AL,'L'
    JNE VALIDATE_ID_BAD
VALIDATE_ID_DIGITS:
    MOV SI,3
    MOV CX,3
VALIDATE_ID_LOOP:
    MOV AL,inputBuffer[SI]
    CMP AL,'0'
    JB VALIDATE_ID_BAD
    CMP AL,'9'
    JA VALIDATE_ID_BAD
    INC SI
    LOOP VALIDATE_ID_LOOP
    MOV AL,1
    RET
VALIDATE_ID_BAD:
    MOV AL,0
    RET
VALIDATE_MEMBER_ID_BUFFER ENDP

